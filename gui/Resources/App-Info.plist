<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist template for TetherKitNext.app.

  Scripts/build-gui.sh replaces __TETHERKITNEXT_VERSION__ with the real version number and copies it into
  TetherKitNext.app/Contents/。

  No entitlements are needed (hardened runtime, Developer ID): the app runs as
  the user and never touches USB or network interfaces itself; privileged work
  goes over XPC to the SMAppService daemon (Contents/MacOS/tetherkitnext-helper).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>TetherKitNext</string>
    <key>CFBundleDisplayName</key>
    <string>TetherKitNext</string>
    <key>CFBundleIdentifier</key>
    <string>com.tetherkitnext.app</string>
    <key>CFBundleExecutable</key>
    <string>TetherKitNext</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Icon used by the Dock / Finder. Resources/AppIcon.icns is copied in by build-gui.sh. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleShortVersionString</key>
    <string>__TETHERKITNEXT_VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__TETHERKITNEXT_BUILD__</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Issen Software Group. Based on TetherKit by XiaoMiku01. MIT License.</string>

    <!-- Supported UI languages.
         The messages themselves are compiled into the binary (see TetherKitNextIPC/Localization.swift for why .lproj is
         not used), so this does **not affect** what is actually displayed -- its purpose is to make
         "System Settings -> General -> Language & Region -> Applications" able to list TetherKitNext and offer
         these two options. The in-app language menu and this entry are independent of each other, and both work.
         The first entry also plays the role of CFBundleDevelopmentRegion. -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>zh-Hans</string>
    </array>

    <!-- Swift's Observation and ContentUnavailableView need macOS 14.
         The command-line part still supports 13.3; the two are independent products. -->
    <!-- GitHub owner/repo whose releases the in-app update check reads. -->
    <key>TetherKitNextUpdateRepository</key>
    <string>AA-EION/TetherKitNext</string>

    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- This is an ordinary app with a window, not a background agent. -->
    <key>LSUIElement</key>
    <false/>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <!-- Being "automatically terminated" by the system while a session is running amounts to cutting off the user's network. -->
    <key>NSSupportsSuddenTermination</key>
    <false/>
</dict>
</plist>
