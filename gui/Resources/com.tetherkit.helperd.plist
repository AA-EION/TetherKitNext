<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchDaemon definition for the TetherKit privileged daemon.

  Shipped inside the app at
    TetherKit.app/Contents/Library/LaunchDaemons/com.tetherkit.helperd.plist
  and registered by the app with SMAppService.daemon(plistName:). launchd then
  runs the daemon in place from the bundle (BundleProgram), so nothing is
  copied to /Library and updating the app updates the daemon.

  The user approves it once in System Settings > General > Login Items.

  No KeepAlive: MachServices makes launchd start the daemon on demand when the
  app connects; once running it stays up while it owns a session.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tetherkit.helperd</string>

    <!-- Relative to the app bundle root. -->
    <key>BundleProgram</key>
    <string>Contents/MacOS/tetherkit-helper</string>

    <!-- Must match HelperConstants.machServiceName. -->
    <key>MachServices</key>
    <dict>
        <key>com.tetherkit.helperd</key>
        <true/>
    </dict>

    <!-- Shows the daemon under TetherKit (not as an anonymous item) in
         System Settings > Login Items. -->
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.tetherkit.app</string>
    </array>

    <key>StandardOutPath</key>
    <string>/var/log/tetherkit-helper.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/tetherkit-helper.log</string>

    <!-- The data path holds BPF descriptors and many USB transfers. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
</dict>
</plist>
