# gui/ is a Swift package, not part of the CMake build, and clang-tidy should not touch it.
#
# The only C file is CTetherKitNext/shim.c, which is merely a SwiftPM formality (every C target needs
# at least one source file); applying the C++ project's naming and modernization rules to it makes no sense.
InheritParentConfig: false
Checks: '-*'
