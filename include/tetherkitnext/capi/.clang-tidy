# Check exemptions for the C ABI layer
#
# This layer is **for C / Swift use**, so naming must follow C conventions (`tk_snake_case`),
# rather than the CamelCase of the project's internal C++ code. Forcing the upper-layer rules would only produce a pile of unfixable warnings,
# so the naming checks are turned off wholesale in this directory.
#
# Likewise, the C ABI can only use PODs and raw pointers, so suggestions like "use std::array / span /
# references" that simply do not apply at an extern "C" boundary are turned off.
InheritParentConfig: true

Checks: >
  -readability-identifier-naming,
  -modernize-deprecated-headers,
  -modernize-use-trailing-return-type,
  -modernize-use-using,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -readability-avoid-const-params-in-decls,
  -bugprone-reserved-identifier,
  -cert-dcl37-c,
  -cert-dcl51-cpp
