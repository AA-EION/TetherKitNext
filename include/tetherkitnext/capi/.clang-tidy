# C ABI 层的检查豁免
#
# 这一层是**给 C / Swift 用的**，命名必须遵守 C 的惯例（`tk_snake_case`），
# 而不是项目内部 C++ 代码的 CamelCase。硬套上层规则只会得到一堆无法修的告警，
# 所以在这个目录里整组关掉命名检查。
#
# 同样地，C ABI 只能用 POD 与裸指针，因此关掉那些「改用 std::array / span /
# 引用」之类在 extern "C" 边界上根本不适用的建议。
InheritParentConfig: true

Checks: >
  -readability-identifier-naming,
  -modernize-deprecated-headers,
  -modernize-use-trailing-return-type,
  -modernize-use-using,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -readability-avoid-const-params-in-decls,
  -bugprone-reserved-identifier,
  -cert-dcl37-c,
  -cert-dcl51-cpp
