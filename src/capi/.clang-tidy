# Check exemptions for the C ABI implementation layer
#
# Reason same as include/tetherkitnext/capi/.clang-tidy: exported function names must follow the C convention
# `tk_snake_case`, and the implementation inevitably has to write C-style fixed-size buffer copies and raw pointers.
InheritParentConfig: true

Checks: >
  -readability-identifier-naming,
  -modernize-use-trailing-return-type,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-type-member-init,
  -bugprone-reserved-identifier,
  -cert-dcl37-c,
  -cert-dcl51-cpp
