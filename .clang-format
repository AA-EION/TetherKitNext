# TetherKitNext code formatting configuration
# Google style as the baseline, with the column limit relaxed to 100 to fit protocol constant tables and long type names.
---
Language: Cpp
BasedOnStyle: Google
Standard: c++20

ColumnLimit: 100
IndentWidth: 2
TabWidth: 2
UseTab: Never
AccessModifierOffset: -1

# Pointers/references bind to the type: TetherKitNext consistently writes `Foo* p`, not `Foo *p`
DerivePointerAlignment: false
PointerAlignment: Left
ReferenceAlignment: Left

# Braces: opening braces of functions and control flow do not break the line (Attach)
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
InsertBraces: true

# One constructor initializer per line, to make diffs easier
BreakConstructorInitializers: BeforeColon
ConstructorInitializerAllOnOneLineOrOnePerLine: true
PackConstructorInitializers: NextLine

# Header grouping: this project's headers > third-party > system/platform > standard library
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"tetherkitnext/'
    Priority: 1
  - Regex: '^<(doctest|libusb)'
    Priority: 2
  - Regex: '^<(sys|net|netinet|mach|pthread|IOKit|CoreFoundation)/'
    Priority: 3
  - Regex: '^<[a-z_]+\.h>'
    Priority: 3
  - Regex: '^<'
    Priority: 4
  - Regex: '.*'
    Priority: 5

# Other
AlwaysBreakTemplateDeclarations: Yes
EmptyLineBeforeAccessModifier: LogicalBlock
FixNamespaceComments: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1
SeparateDefinitionBlocks: Always
SpacesBeforeTrailingComments: 2
QualifierAlignment: Left
